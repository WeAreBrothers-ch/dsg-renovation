# ============================================================
# DSG RÉNOVATION — CONFIGURATION DU SERVEUR (Apache, Infomaniak)
#
# Une seule adresse par page, des fichiers internes introuvables,
# une page 404 utile, et des fichiers mis en cache longtemps.
# ============================================================

Options -Indexes
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

AddType font/woff2 .woff2
AddType image/avif .avif
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS partout. Infomaniak peut chiffrer en amont du serveur : on
  #    ne redirige que si AUCUN des deux signaux n'indique HTTPS, ce qui
  #    exclut toute boucle. (Le Manager propose aussi « Forcer HTTPS ».)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Une seule adresse pour le site : www.dsg-renov.ch, celle des
  #    balises canonical et du plan du site.
  RewriteCond %{HTTP_HOST} ^dsg-renov\.ch$ [NC]
  RewriteRule ^ https://www.dsg-renov.ch%{REQUEST_URI} [R=301,L]

  # 3. /index.html n'est pas une seconde adresse de l'accueil.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # 4. Les fichiers de fabrication n'existent pas pour un visiteur :
  #    générateur, documents de travail, historique git.
  RewriteRule ^(outils|\.git|\.github)(/|$) - [R=404,L]
  RewriteRule \.(md|py|pyc|sh)$ - [R=404,L]
  RewriteRule ^\.gitignore$ - [R=404,L]
  RewriteRule ^envoi-reglages\.php$ - [R=404,L]

  # 5. ANCIENNES ADRESSES DU SITE WIX → nouvelles pages (301), pour
  #    garder le référencement acquis par l'ancien site. Relevées le
  #    13/10/2026 dans les archives de la Wayback Machine (2022–2026).
  #    Les accents s'écrivent tels quels (Apache compare l'adresse
  #    décodée, octet par octet : une lettre accentuée en fait deux,
  #    d'où « (é|e) » et non « [ée] ») ; la variante sans accent est
  #    prise aussi. « qui-sommes-nous » n'a pas de fin imposée : Wix
  #    l'écrivait « qui-sommes-nous%3F ».
  #    services, devis, realisations et mentions-legales sont aussi les
  #    adresses du nouveau site : elles ne redirigent pas.
  RewriteRule ^(nos-prestations|prestations)/?$ /services/ [R=301,L]
  RewriteRule ^(projets|réalisations|single-project|copie-de-projet-[0-9]+)/?$ /realisations [R=301,L]
  RewriteRule ^((à|a)-propos|about|carri(è|e)res)/?$ /entreprise [R=301,L]
  RewriteRule ^qui-sommes-nous /entreprise [R=301,L]
  RewriteRule ^contact/?$ /devis [R=301,L]
  RewriteRule ^mentions-légales/?$ /mentions-legales [R=301,L]
  RewriteRule ^politique-de-(confidentialit(é|e)|cookies)/?$ /confidentialite [R=301,L]

  # 6. Les pages se publient sans « .html » : /services/peinture sert
  #    services/peinture.html. L'ancienne adresse en « .html » renvoie
  #    vers la nouvelle (une seule adresse par page, requête et ancre
  #    gardées), et un « / » final est retiré (/devis/ → /devis), sans
  #    quoi les liens relatifs de la page se perdraient. La page des
  #    prestations est la page d'accueil de son dossier, /services/
  #    (services/index.html) : Infomaniak ajoute de lui-même le « / »
  #    d'un dossier. 404.html ne sert qu'aux erreurs.
  RewriteRule ^services\.html$ /services/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?(?!404\.)[^/?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  RewriteCond $1 !^404$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml image/x-icon
</IfModule>

# ---------- Cache ----------
# Feuille de style et scripts portent leur version dans l'adresse
# (?v=…, posée par construire.py) : ils peuvent être gardés un an.
# Les pages, elles, se revalident à chaque visite.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ---------- Sécurité ----------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS : Infomaniak envoie déjà le sien (max-age=16000000, relevé le
  # 13/10/2026). Ne pas activer cette ligne, qui le doublerait.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
